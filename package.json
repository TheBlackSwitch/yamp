{
    "devDependencies": {
        "typescript": "^5.7.3",
        "tsup": "^8.5.1"
    },
    "scripts": {
        "build": "npx tsup src/main.ts --format esm,cjs,iife --dts --clean --global-name Yamp",
        "demo": "cd ./demo && php -S localhost:8001"
    },
    "name": "@theblackswitch/yamp",
    "version": "0.0.7",
    "type": "module",
    "main": "./dist/main.ts",
    "types": "./dist/public_types.d.ts",
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "import": "./dist/main.js",
            "require": "./dist/main.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/TheBlackSwitch/yamp"
    },
    "bugs": {
        "url": "https://github.com/TheBlackSwitch/yamp/issues"
    },
    "homepage": "https://github.com/TheBlackSwitch/yamp#readme",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    }
}
